generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  email            String        @unique
  name             String?
  passwordHash     String?
  googleId         String?
  stripeCustomerId String?
  role             String        @default("user")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  projects     Project[]
  subscription Subscription?
}

model Plan {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  slug                 String   @unique
  monthlyPrice         Int
  yearlyPrice          Int
  stripePriceIdMonthly String
  stripePriceIdYearly  String
  features             String[]
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Subscription {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @unique @db.ObjectId
  user                 User     @relation(fields: [userId], references: [id])
  planId               String   @db.ObjectId
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  status               String
  interval             String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Project {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  name      String
  siteUrl   String
  publicKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  elements  ElementConfig[]
  audiences Audience[]
}

model ElementConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  selector  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]
  rules    Rule[]
}

model Variant {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  elementId String        @db.ObjectId
  element   ElementConfig @relation(fields: [elementId], references: [id], onDelete: Cascade)
  name      String
  mutations Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  rules Rule[]
}

model Rule {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  elementId   String        @db.ObjectId
  element     ElementConfig @relation(fields: [elementId], references: [id], onDelete: Cascade)
  description String?
  conditions  Json
  logic       String
  variantId   String        @db.ObjectId
  variant     Variant       @relation(fields: [variantId], references: [id])
  priority    Int
  enabled     Boolean       @default(true)
  startDate   DateTime?
  endDate     DateTime?
  splits      Json?
  audienceId  String?       @db.ObjectId
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Audience {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  conditions Json
  logic      String   @default("AND")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  elementId   String
  variantId   String
  ruleId      String?
  type        String
  visitorId   String
  url         String?
  country     String?
  countryCode String?
  device      String?
  timestamp   DateTime @default(now())

  @@index([projectId, timestamp])
  @@index([projectId, variantId])
}

// ─── User Journey Tracking ───────────────────────────────────────────

model Visitor {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String   @db.ObjectId
  visitorId        String
  country          String?
  countryCode      String?
  region           String?
  city             String?
  language         String?
  device           String?
  browser          String?
  os               String?
  firstReferrer    String?
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?
  totalSessions    Int      @default(0)
  totalPageviews   Int      @default(0)
  totalEvents      Int      @default(0)
  email            String?
  polarCustomerId  String?
  totalRevenue     Int      @default(0)
  tags             String[]
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@unique([projectId, visitorId])
  @@index([projectId, lastSeenAt])
  @@index([projectId, email])
  @@index([projectId, firstSeenAt])
}

model Session {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  visitorId   String
  sessionId   String
  entryPage   String?
  exitPage    String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String?
  browser     String?
  os          String?
  country     String?
  countryCode String?
  pageviews   Int      @default(0)
  events      Int      @default(0)
  duration    Int      @default(0)
  startedAt   DateTime @default(now())
  endedAt     DateTime @default(now())

  @@unique([projectId, sessionId])
  @@index([projectId, startedAt])
  @@index([projectId, visitorId])
}

model PageView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  visitorId   String
  sessionId   String
  url         String
  title       String?
  referrer    String?
  duration    Int?
  scrollDepth Int?
  timestamp   DateTime @default(now())

  @@index([projectId, timestamp])
  @@index([projectId, visitorId])
  @@index([projectId, sessionId])
}

model TrackEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  visitorId  String
  sessionId  String
  name       String
  properties Json?
  url        String?
  timestamp  DateTime @default(now())

  @@index([projectId, timestamp])
  @@index([projectId, visitorId])
  @@index([projectId, sessionId])
  @@index([projectId, name])
}

model Integration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  type      String
  config    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, type])
}

model CustomerEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String   @db.ObjectId
  visitorId     String?
  type          String
  amount        Int?
  currency      String?
  productName   String?
  customerEmail String?
  externalId    String?
  provider      String
  metadata      Json?
  timestamp     DateTime @default(now())

  @@index([projectId, timestamp])
  @@index([projectId, visitorId])
}
